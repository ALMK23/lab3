# Скопируйте этот файл в .env и при желании поменяйте пароли.
# .env содержит секреты и НЕ попадает в git (см. .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=translations
DB_SCHEMA=app

# Владелец схемы: создаёт таблицы (используется только Flyway при старте)
DB_OWNER_USER=translations_owner
DB_OWNER_PASSWORD=owner_secret_change_me

# Пользователь приложения: только SELECT / INSERT / UPDATE / DELETE
DB_APP_USER=translations_app
DB_APP_PASSWORD=app_secret_change_me

# Пароль суперпользователя postgres — нужен только docker-compose при первом запуске
POSTGRES_SUPERUSER_PASSWORD=postgres_secret_change_me

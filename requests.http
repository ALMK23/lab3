Content-Type: application/json

{
  "name": "Борис Переводов"
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("name = Борис Переводов", () => client.assert(response.body["name"] === "Борис Переводов"));
%}

### ✗ Email уже занят → 409
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Двойник",
  "email": "ANNA.{{runId}}@example.com"
}

> {%
    client.test("HTTP 409", () => client.assert(response.status === 409, "Ожидался 409, получен " + response.status));

  "translationId": {{t1Id}},
  "text": "Проверьте регистр"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("c2Id", response.body["id"]);
    client.test("status = OPEN", () => client.assert(response.body["status"] === "OPEN"));
%}


### ================= 6. БО-2 Отправка на согласование =================
### DRAFT/REJECTED → SUBMITTED. Только автор; без открытых замечаний; у сегмента один активный перевод.

### ✗ Отправка чужого перевода → 403
POST http://localhost:8080/api/translations/{{t1Id}}/submit
Content-Type: application/json

{
  "userId": {{translator2Id}}
}

> {%
    client.test("HTTP 403", () => client.assert(response.status === 403, "Ожидался 403, получен " + response.status));
%}

### Борис отправляет перевод
POST http://localhost:8080/api/translations/{{t1Id}}/submit
Content-Type: application/json

{
  "userId": {{translatorId}}
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("status = SUBMITTED", () => client.assert(response.body["status"] === "SUBMITTED"));
%}

### ✗ Править текст на согласовании → 409
PATCH http://localhost:8080/api/translations/{{t1Id}}
Content-Type: application/json

{
  "text": "Hi"
}

> {%
    client.test("HTTP 409", () => client.assert(response.status === 409, "Ожидался 409, получен " + response.status));
%}

### ✗ Второй активный перевод сегмента → 409
POST http://localhost:8080/api/translations/{{t3Id}}/submit
Content-Type: application/json

{
  "userId": {{translator2Id}}
}

> {%
    client.test("HTTP 409", () => client.assert(response.status === 409, "Ожидался 409, получен " + response.status));
%}

### Удалить конкурирующий черновик
DELETE http://localhost:8080/api/translations/{{t3Id}}

> {%
    client.test("HTTP 204", () => client.assert(response.status === 204, "Ожидался 204, получен " + response.status));

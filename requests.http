### Вариант 16. Согласование переводов — полный сценарий.
### Выполняйте запросы сверху вниз (или «Run All Requests in File»): id сохраняются в переменные.
### Запросы с «✗» — негативные проверки бизнес-правил, они ДОЛЖНЫ вернуть ошибку.

### ================= 0. Тестовые данные из миграции =================
### Данные, которые Flyway кладёт в БД при первом запуске (V2__seed_data.sql).

### Список проектов (seed)
< {%
    client.global.set("runId", Date.now().toString());
%}
GET http://localhost:8080/api/translation-projects

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### Список переводов (seed)
GET http://localhost:8080/api/translations

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### ================= 1. Пользователи — CRUD =================
### Редактор (владелец проекта) и два переводчика.

### Создать редактора Анну
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Анна Редакторова",
  "email": "anna.{{runId}}@example.com"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("editorId", response.body["id"]);
%}

### Создать переводчика Бориса
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Борис",
  "email": "boris.{{runId}}@example.com"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("translatorId", response.body["id"]);
%}

### Создать переводчицу Веру
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Вера Лингвистова",
  "email": "vera.{{runId}}@example.com"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("translator2Id", response.body["id"]);
%}

### Создать временного пользователя
POST http://localhost:8080/api/users
Content-Type: application/json

{
  "name": "Гость",
  "email": "guest.{{runId}}@example.com"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("tmpUserId", response.body["id"]);
%}

### Список пользователей
GET http://localhost:8080/api/users

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### Пользователь по id
GET http://localhost:8080/api/users/{{editorId}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));

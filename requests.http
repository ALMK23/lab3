{
  "userId": {{editorId}}
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("translation.status = APPROVED", () => client.assert(response.body["translation"]["status"] === "APPROVED"));
    client.test("project.status = IN_PROGRESS", () => client.assert(response.body["project"]["status"] === "IN_PROGRESS"));
%}


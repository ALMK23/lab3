    client.test("position = 3", () => client.assert(response.body["position"] === 3));
%}

### Список сегментов
GET http://localhost:8080/api/source-segments

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### Сегмент по id
GET http://localhost:8080/api/source-segments/{{seg2Id}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("projectId", () => client.assert(response.body["projectId"] == client.global.get("projectId")));
%}

### Изменить текст сегмента 2
PATCH http://localhost:8080/api/source-segments/{{seg2Id}}
Content-Type: application/json

{
  "sourceText": "Введите пароль ещё раз"
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));

### ================= 9. БО-5 Устранение замечания =================
### OPEN → RESOLVED у замечания и исправленный текст у перевода — две сущности сразу.

### ✗ Устранение не автором → 403
POST http://localhost:8080/api/editorial-comments/{{c1Id}}/resolve
Content-Type: application/json

{
  "userId": {{editorId}}
}

> {%
    client.test("HTTP 403", () => client.assert(response.status === 403, "Ожидался 403, получен " + response.status));
%}

### Борис устраняет замечание
POST http://localhost:8080/api/editorial-comments/{{c1Id}}/resolve
Content-Type: application/json

{
  "userId": {{translatorId}},
  "translationText": "Welcome to our store!"
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("comment.status = RESOLVED", () => client.assert(response.body["comment"]["status"] === "RESOLVED"));
    client.test("translation.text = Welcome to our store!", () => client.assert(response.body["translation"]["text"] === "Welcome to our store!"));
    client.test("translation.status = REJECTED", () => client.assert(response.body["translation"]["status"] === "REJECTED"));
%}


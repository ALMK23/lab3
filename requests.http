### ================= 2. Проекты — CRUD =================
### Новый проект всегда создаётся в статусе DRAFT; статус меняют только бизнес-операции.

### Создать проект
POST http://localhost:8080/api/translation-projects
Content-Type: application/json

{
  "name": "Локализация интернет-магазина",
  "targetLanguage": "en",
  "ownerId": {{editorId}}
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("projectId", response.body["id"]);
    client.test("status = DRAFT", () => client.assert(response.body["status"] === "DRAFT"));
    client.test("ownerId", () => client.assert(response.body["ownerId"] == client.global.get("editorId")));
%}

### ✗ Статус напрямую → 400
POST http://localhost:8080/api/translation-projects
Content-Type: application/json

{
  "name": "Хитрый",
  "targetLanguage": "en",
  "ownerId": {{editorId}},
  "status": "COMPLETED"
}

> {%
    client.test("HTTP 400", () => client.assert(response.status === 400, "Ожидался 400, получен " + response.status));
%}

### ✗ Несуществующий владелец → 400
POST http://localhost:8080/api/translation-projects
Content-Type: application/json

{
  "name": "Ничей",
  "targetLanguage": "en",
  "ownerId": 999999
}

> {%
    client.test("HTTP 400", () => client.assert(response.status === 400, "Ожидался 400, получен " + response.status));
%}

### Создать пустой проект
POST http://localhost:8080/api/translation-projects
Content-Type: application/json

{
  "name": "Пустой проект",
  "targetLanguage": "fr",
  "ownerId": {{editorId}}
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("emptyProjectId", response.body["id"]);
%}

### Список проектов
GET http://localhost:8080/api/translation-projects

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### Проект по id
GET http://localhost:8080/api/translation-projects/{{projectId}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("status = DRAFT", () => client.assert(response.body["status"] === "DRAFT"));
%}

### Переименовать проект
PATCH http://localhost:8080/api/translation-projects/{{projectId}}
Content-Type: application/json

{
  "name": "Локализация магазина (EN)"
}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("name = Локализация магазина (EN)", () => client.assert(response.body["name"] === "Локализация магазина (EN)"));
%}

### ================= 3. Исходные сегменты — CRUD =================
### Позиция без указания ставится в конец; две позиции в проекте не совпадают.

### Создать сегмент 1
POST http://localhost:8080/api/source-segments
Content-Type: application/json

{
  "projectId": {{projectId}},
  "sourceText": "Добро пожаловать!"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("seg1Id", response.body["id"]);
    client.test("position = 1", () => client.assert(response.body["position"] === 1));
%}

### Создать сегмент 2
POST http://localhost:8080/api/source-segments
Content-Type: application/json

{
  "projectId": {{projectId}},
  "sourceText": "Введите пароль"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("seg2Id", response.body["id"]);
    client.test("position = 2", () => client.assert(response.body["position"] === 2));
%}

### ✗ Занятая позиция → 409
POST http://localhost:8080/api/source-segments
Content-Type: application/json

{
  "projectId": {{projectId}},
  "sourceText": "Дубль",
  "position": 2
}

> {%
    client.test("HTTP 409", () => client.assert(response.status === 409, "Ожидался 409, получен " + response.status));
%}

### Создать временный сегмент

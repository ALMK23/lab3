    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("Массив", () => client.assert(Array.isArray(response.body)));
%}

### Перевод по id
GET http://localhost:8080/api/translations/{{t1Id}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    client.test("text = Welcome!", () => client.assert(response.body["text"] === "Welcome!"));
%}

### Поправить черновик
PATCH http://localhost:8080/api/translations/{{t1Id}}
Content-Type: application/json

{
  "text": "Welcome"

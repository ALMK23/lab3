    client.test("status = SUBMITTED", () => client.assert(response.body["status"] === "SUBMITTED"));
%}

### Анна оставляет вопрос к переводу
POST http://localhost:8080/api/editorial-comments
Content-Type: application/json

{
  "translationId": {{t2Id}},
  "text": "Может, лучше «Re-enter password»?"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    client.global.set("c3Id", response.body["id"]);
%}

